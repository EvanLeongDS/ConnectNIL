# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email (Resend — https://resend.com)
RESEND_API_KEY=re_...
# Optional. Must be a verified sender/domain in Resend. Default uses Resend’s test address
# (with the test “from”, Resend often only delivers to addresses you’ve verified in the dashboard).
# RESEND_FROM=ConnectNIL <noreply@yourdomain.com>

# reCAPTCHA v2 (https://www.google.com/recaptcha/admin)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your-site-key
RECAPTCHA_SECRET_KEY=your-secret-key

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AWS S3 (deliverable proof images)
# S3_* is authoritative. The AWS_* names (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY /
# AWS_REGION) are honoured ONLY when not running on Vercel -- Vercel functions run on
# Lambda, whose runtime injects its own values under exactly those names. Picking those up
# would make the app believe it is configured and then sign every request with credentials
# that cannot reach the proof bucket. On Vercel, set the S3_* names.
S3_REGION=us-east-1
S3_BUCKET=your-proofs-bucket-name-no-dots
S3_ACCESS_KEY_ID=AKIA...
S3_SECRET_ACCESS_KEY=...

# Where NEW proof submissions are written: "s3" or "supabase" (legacy).
# Reads are always dual-mode, so flipping this back is an instant rollback.
PROOF_STORAGE_DRIVER=supabase
# Lifetime of a presigned proof-image GET URL, in seconds.
PROOF_READ_URL_TTL=3600

# Shared secret for the proof intelligence pipeline callback
# (app/api/internal/proof-processed). The Lambda signs its report with this; the route
# refuses anything unsigned. Same value must be in the SSM SecureString the CDK stack
# grants the Lambda -- see infra/README.md. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROOF_PIPELINE_SECRET=

# Vercel OIDC. Set to the `VercelRoleArn` output of the foundation stack and the app
# federates for short-lived credentials instead of using the static keys above.
#
# It takes precedence the moment it is set, so migrate in this order:
#   1. set AWS_ROLE_ARN
#   2. confirm GET /api/internal/proof-processed reports "credentials":"oidc"
#   3. only then delete S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY
# Unsetting it falls straight back to the static keys, so rollback is instant.
#
# Localhost keeps using the static keys either way: the role's trust policy pins
# environment:production, so a locally pulled VERCEL_OIDC_TOKEN is refused by STS.
# AWS_ROLE_ARN=arn:aws:iam::<account>:role/connectnil-vercel-app
