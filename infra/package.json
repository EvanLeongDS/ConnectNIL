{
  "name": "connectnil-infra",
  "version": "0.1.0",
  "private": true,
  "description": "AWS CDK app for ConnectNIL. Deliberately separate from the Next.js package.json so CDK never enters the app bundle.",
  "scripts": {
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy": "cdk deploy --all",
    "destroy": "cdk destroy --all",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.150.0",
    "constructs": "^10.3.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@aws-sdk/client-rekognition": "^3.1127.0",
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/client-ssm": "^3.1127.0",
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.0.0",
    "aws-cdk": "^2.1000.0",
    "esbuild": "^0.24.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
